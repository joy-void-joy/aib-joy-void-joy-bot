{
  "coauthorship": false,
  "enabledPlugins": {
    "agent-sdk-dev@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "lup@aib-repository": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "aib-repository": {
      "source": {
        "path": "./.claude/plugins",
        "source": "directory"
      }
    }
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "Read(./.claude/settings.json.local*)",
      "mcp__plugin_lup_search",
      "mcp__plugin_lup_financial",
      "mcp__plugin_lup_government",
      "mcp__plugin_lup_markets",
      "mcp__plugin_lup_trends",
      "mcp__plugin_lup_weather"
    ],
    "deny": [
      "Read(./**/*.local*)",
      "Read(~/.ssh)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.aws/credentials/**)"
    ]
  },
  "sandbox": {
    "credentials": {
      "files": [
        {
          "mode": "deny",
          "path": "~/.ssh"
        },
        {
          "mode": "deny",
          "path": "~/.aws/credentials"
        }
      ]
    },
    "enabled": true,
    "excludedCommands": [
      "ssh *",
      "git *",
      "gh *",
      "docker *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.cache/uv"
      ],
      "denyWrite": [
        "README.md"
      ]
    },
    "network": {
      "allowedDomains": [
        "docs.claude.com",
        "code.claude.com",
        "platform.claude.com",
        "ai.pydantic.dev",
        "www.metaculus.com",
        "metaculus.com",
        "docs.polymarket.com",
        "docs.manifold.markets",
        "docs.asknews.app",
        "mcp.asknews.app",
        "github.com",
        "api.github.com",
        "pypi.org",
        "files.pythonhosted.org",
        "githubusercontent.com",
        "*.githubusercontent.com",
        "127.0.0.1",
        "localhost",
        "api.anthropic.com"
      ]
    }
  }
}
