#!/bin/sh
# lup-git-guard: written by `uv run lup-devtools dev git-hooks install`.
(
# Refuses this commit while a generated artifact differs from what
# its source renders. Settle it with `uv run lup-devtools harness generate all`.
# Dropped so the check below resolves this repository from the
# directory it runs in. Git names it here too, and that name would
# outrank the `-C` a test's throwaway repository binds git with.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR
exec uv run lup-devtools harness check all
) || exit $?
# Refuses a commit mixing forecast data with code. Data lands
# on main; code goes through a worktree and a PR.
# Dropped so the check below resolves this repository from the
# directory it runs in. Git names it here too, and that name would
# outrank the `-C` a test's throwaway repository binds git with.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR
exec uv run lup-devtools dev data-split
