#!/bin/sh
# lup-git-guard: written by `uv run lup-devtools dev git-hooks install`.
# Git delivers this moment's stdin once, and more than one guard
# below reads it. Captured here and replayed to each, so the first
# to read does not drain it for the rest.
guarded_stdin=$(cat)
replay_stdin() { [ -z "$guarded_stdin" ] || printf '%s\n' "$guarded_stdin"; }
replay_stdin | (
# Refuses a branch whose PR would carry forecast data, which
# is what an unpublished main does. Publish main first.
# Dropped so the check below resolves this repository from the
# directory it runs in. Git names it here too, and that name would
# outrank the `-C` a test's throwaway repository binds git with.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR
exec uv run lup-devtools dev pr-base
) || exit $?
replay_stdin | (
# Refuses this push while the gate fails. A commit is local
# and rewritable; a push is neither. Run `uv run lup-devtools dev gate`.
# Dropped so the check below resolves this repository from the
# directory it runs in. Git names it here too, and that name would
# outrank the `-C` a test's throwaway repository binds git with.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR
# A push that only deletes refs uploads nothing for the check below to judge.
# Git names each update on stdin as `<local ref> <local oid> <remote ref>
# <remote oid>` and writes an all-zero local oid where a ref is being deleted;
# anything else is content this push answers for, and a line that does not
# parse counts as content rather than being trusted into a standdown.
carries_content=''
while read -r _ local_oid _; do
  case "$local_oid" in
    '' | *[!0]*) carries_content=yes ;;
  esac
done
[ -n "$carries_content" ] || exit 0
exec uv run lup-devtools dev gate
)
